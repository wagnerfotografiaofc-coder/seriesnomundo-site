{
  "functions": {
    "api/generate-posts.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/filmes",
      "destination": "/filmes.html"
    },
    {
      "source": "/series",
      "destination": "/series.html"
    },
    {
      "source": "/quizzes",
      "destination": "/quizzes.html"
    },
    {
      "source": "/sobre",
      "destination": "/sobre.html"
    },
    {
      "source": "/privacidade",
      "destination": "/privacidade.html"
    },
    {
      "source": "/aviso-legal",
      "destination": "/aviso-legal.html"
    },
    {
      "source": "/redes-sociais",
      "destination": "/redes-sociais.html"
    },
    {
      "source": "/quiz/:id",
      "destination": "/play-quiz.html?id=:id"
    },
    {
      "source": "/posts/:slug",
      "destination": "/post.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://oxrtghthalavxcyqskaz.supabase.co wss://oxrtghthalavxcyqskaz.supabase.co; frame-src https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://oxrtghthalavxcyqskaz.supabase.co"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
